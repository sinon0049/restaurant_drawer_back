# Local development settings. Replace placeholder values in your private .env file.
NODE_ENV=development
PORT=3000

# Generate separate, random secrets for local development.
SECRET=replace-with-a-random-jwt-secret
SESSION_SECRET=replace-with-a-random-session-secret

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace-with-your-local-postgres-password
PG_DATABASE=restaurant_drawer

# Redis (local Redis server)
REDIS_URL=redis://localhost:6379

# Google Places API
GOOGLE_MAPS_APIKEY=replace-with-your-google-maps-api-key

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=replace-with-your-facebook-app-id
FACEBOOK_CLIENT_SECRET=replace-with-your-facebook-app-secret

# Public origins used in OAuth callback URLs and redirects
BACKEND_URL=https://localhost:3000
FRONTEND_URL=https://localhost:5173
